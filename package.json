{
  "name": "av-postpilot",
  "productName": "AV PostPilot",
  "version": "1.9.1",
  "description": "Edit-bay assistant for DaVinci Resolve: automatic .drp backups, render actions and notifications",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:zip": "electron-builder --win zip --x64 -c.win.artifactName=AV-PostPilot-${version}-Windows-Portable.${ext}"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.house.avpostpilot",
    "productName": "AV PostPilot",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AV-PostPilot-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resolve + AV PostPilot",
      "runAfterFinish": false
    }
  },
  "dependencies": {
    "nodemailer": "^10.0.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
