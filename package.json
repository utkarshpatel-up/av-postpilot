{
  "name": "av-postpilot",
  "productName": "AV PostPilot",
  "version": "3.4.2",
  "description": "Edit-bay assistant for DaVinci Resolve: automatic .drp backups, render actions and notifications",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/fetch-handbrake.js",
    "test": "node --test tests/*.test.js",
    "fetch-handbrake": "node scripts/fetch-handbrake.js",
    "build-feedback-engine": "node scripts/build-feedback-engine.js",
    "predist:win": "node scripts/fetch-handbrake.js win && node scripts/build-feedback-engine.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "predist:zip": "node scripts/fetch-handbrake.js win && node scripts/build-feedback-engine.js",
    "dist:zip": "electron-builder --win zip --x64 --publish never -c.win.artifactName=AV-PostPilot-${version}-Windows-Portable.${ext}",
    "predist:mac": "node scripts/fetch-handbrake.js mac",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.house.avpostpilot",
    "publish": {
      "provider": "github",
      "owner": "utkarshpatel-up",
      "repo": "av-postpilot",
      "releaseType": "release"
    },
    "productName": "AV PostPilot",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AV-PostPilot-${version}-Windows-Setup.${ext}",
      "extraResources": [
        {
          "from": "vendor/feedback-engine/win/feedback-engine",
          "to": "feedback-engine/feedback-engine"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "AV-PostPilot-${version}-macOS-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/feedback-engine/mac-${arch}/feedback-engine",
          "to": "feedback-engine/feedback-engine"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resolve + AV PostPilot",
      "runAfterFinish": false
    },
    "extraResources": [
      {
        "from": "vendor/handbrake/${os}",
        "to": "handbrake",
        "filter": [
          "**/*",
          "!VERSION"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "nodemailer": "^10.0.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "handbrakeCli": {
    "version": "1.11.2",
    "files": {
      "win": {
        "version": "1.9.2",
        "name": "HandBrakeCLI-1.9.2-win-x86_64.zip",
        "sha256": "cc875eda177a4105b99664136719c893db989a4456c4d3a9fc9e8d8742018413"
      },
      "mac": {
        "name": "HandBrakeCLI-1.11.2.dmg",
        "sha256": "14463aa81038aaa3ce421dc6cee65fd6c82fdabda040931541ccca38939299fa"
      }
    }
  }
}
